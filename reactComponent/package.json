{
  "name": "@cristianmpx/aiui-assistant",
  "version": "0.1.21",
  "description": "Framework-agnostic visual widget with bundled Preact and zero runtime dependencies for AI-assisted frontend development",
  "type": "module",
  "main": "./dist/aiui-assistant.cjs",
  "module": "./dist/aiui-assistant.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/aiui-assistant.js",
      "require": "./dist/aiui-assistant.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs && node scripts/smoke-global.mjs",
    "example:install": "npm install --prefix example",
    "example:dev": "npm run dev --prefix example"
  },
  "keywords": [
    "react",
    "ai",
    "assistant",
    "component"
  ],
  "author": {
    "name": "Cristian M.",
    "url": "https://github.com/cristianm-developer"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cristianm-developer/aiui-assistant",
    "directory": "reactComponent"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "html2canvas": "^1.4.1",
    "jsdom": "^25.0.1",
    "preact": "^10.29.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.4"
  }
}
